{
  "sections": {
    "hero_slider": {
      "type": "hero-metaobject-slider",
      "settings": {
        "source": "metaobject",
        "metaobject_handle": "hero_slide",
        "auto_rotate": true,
        "change_slides_speed": 5,
        "image_overlay_opacity": 15,
        "desktop_content_position": "bottom-left",
        "heading_size": "h1",
        "show_text_box": false,
        "color_scheme": "scheme-1"
      }
    },
    "shop_by_category": {
      "type": "shop-by-category",
      "settings": {
        "title": "SHOP BY CATEGORY",
        "collections_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1"
      }
    },
    "product_highlight": {
      "type": "featured-product-highlight",
      "settings": {
        "source": "metaobject",
        "metaobject_handle": "product_highlight",
        "image_position": "left",
        "auto_rotate": true,
        "change_slides_speed": 2,
        "content_background": "#EFE8DC",
        "color_scheme": "scheme-1"
      }
    },
    "new_arrivals": {
      "type": "new-arrivals-marquee",
      "settings": {
        "eyebrow": "NEW ARRIVALS",
        "heading": "New this season",
        "products_to_show": 8,
        "columns_desktop": 4,
        "view_all_label": "VIEW ALL NEW",
        "view_all_link": "shopify://collections/all",
        "color_scheme": "scheme-1"
      }
    },
    "trending_articles": {
      "type": "trending-articles",
      "settings": {
        "eyebrow": "TRENDING ARTICLES",
