      "settings": {
        "heading": "Discover Our Curated Collection of Timeless Jewelry, Crafted to Make Every Moment Special.",
        "subheading": "",
        "scroll_height": 600,
        "card_width": 380,
        "spiral_radius": 550,
        "step_angle": 50,
        "pitch": 160,
        "camera_tilt": -4,
        "background_color": "#F7F3EB",
        "text_color": "#1C1A16",
        "card_background": "#EFE8DC",
        "show_price": true,
        "padding_top": 80,
        "padding_bottom": 0,
        "card_ratio": "5/4"
      }
