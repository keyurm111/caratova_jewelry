        "card_3": {
          "type": "card",
          "settings": {
            "number": "03",
            "title": "Sculpted Bangles",
            "price_or_label": "$540"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "number": "04",
            "title": "Hammered Earrings",
            "price_or_label": "$420"
          }
        },
        "card_5": {
          "type": "card",
          "settings": {
            "number": "05",
            "title": "Solar Medallions",
            "price_or_label": "$590"
          }
        },
        "card_6": {
          "type": "card",
          "settings": {
            "number": "06",
            "title": "Azure Florals",
            "price_or_label": "$740"
