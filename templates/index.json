        "color_scheme": "scheme-1"
      }
    },
    "brand_story": {
      "type": "brand-story",
      "settings": {
        "eyebrow": "OUR CRAFT",
        "heading": "Patience, set in gold",
        "description": "<p>Every Aurelle piece is cast, set, and finished by hand in a single atelier. We make fewer things, more carefully - and repair them for life.</p>",
        "button_label": "DISCOVER OUR CRAFT",
        "button_link": "shopify://collections/all",
        "layout": "text_first",
        "content_background": "#EFE8DC",
        "color_scheme": "scheme-1"
      }
    },
    "spiral_3d": {
      "type": "spiral-3d",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "number": "01",
            "title": "Onyx & Gold",
            "price_or_label": "$680"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "number": "02",
            "title": "Diamond Solitaires",
            "price_or_label": "$1,250"
