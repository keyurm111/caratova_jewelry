{{ 'section-about-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #AboutValues-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#F7F3EB' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #AboutValues-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }
  }
{%- endstyle -%}

<section
  class="about-values-section"
  id="AboutValues-{{ section.id }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="page-width">
    
    <div class="about-values__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="about-values__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="about-values__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
    </div>

    <div class="about-values__grid">
      {%- for block in section.blocks -%}
        <div class="about-values__card" {{ block.shopify_attributes }}>
          {%- if block.settings.eyebrow != blank -%}
            <span class="about-values__card-eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="about-values__card-title">
              {{ block.settings.title }}
            </h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="about-values__card-text">
              {{ block.settings.text }}
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About Brand Values",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F7F3EB"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR CREED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Values That Define Caratova"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 180,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value Column",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Tag",
          "default": "CRAFT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Exceptional Craftsmanship"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "We reject the hurried pace of mass production. Every facet is scrutinized under ten-power magnification to ensure structural harmony, balanced weight, and incandescent brilliance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Brand Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "eyebrow": "CRAFT",
            "title": "Exceptional Craftsmanship",
            "text": "We reject the hurried pace of mass production. Every facet is scrutinized under ten-power magnification to ensure structural harmony, balanced weight, and incandescent brilliance."
          }
        },
        {
          "type": "value",
          "settings": {
            "eyebrow": "AESTHETIC",
            "title": "Timeless Design",
            "text": "Rooted in classical proportions and modern organic minimalism, our silhouettes are sculpted to transcend fleeting trends and become cherished heirlooms across generations."
          }
        },
        {
          "type": "value",
          "settings": {
            "eyebrow": "DEVOTION",
            "title": "Meaningful Elegance",
            "text": "Fine jewelry is never mere decoration; it is an intimate talisman of personal triumph, quiet strength, and cherished memories rendered permanent in precious metal."
          }
        }
      ]
    }
  ]
}
{% endschema %}

