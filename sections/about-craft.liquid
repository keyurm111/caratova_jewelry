{{ 'section-about-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #AboutCraft-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#F7F3EB' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #AboutCraft-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px;
    }
  }
{%- endstyle -%}

<section
  class="about-craft-section"
  id="AboutCraft-{{ section.id }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="page-width">
    <div class="about-craft__grid">
      
      <div class="about-craft__media">
        <div class="about-craft__media-wrap">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 50vw, 100vw',
                widths: '400, 600, 800, 1000, 1400',
                class: 'about-craft__img'
            }}
          {%- else -%}
            <img
              src="{{ 'about-craft-workbench.jpg' | asset_url }}"
              alt="{{ section.settings.heading | escape }}"
              class="about-craft__img"
              loading="lazy"
              width="1400"
              height="933"
            >
          {%- endif -%}
        </div>
      </div>

      <div class="about-craft__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="about-craft__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="about-craft__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="about-craft__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        <div class="about-craft__highlights">
          <div class="about-craft__highlight-item">
            <svg class="about-craft__highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3h12l4 6-10 12L2 9l4-6z"></path>
              <path d="M2 9h20"></path>
              <path d="M10 3l-2 6 4 12 4-12-2-6"></path>
            </svg>
            <span class="about-craft__highlight-value">{{ section.settings.stat_1_val }}</span>
            <span class="about-craft__highlight-label">{{ section.settings.stat_1_label }}</span>
          </div>

          <div class="about-craft__highlight-item">
            <svg class="about-craft__highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="about-craft__highlight-value">{{ section.settings.stat_2_val }}</span>
            <span class="about-craft__highlight-label">{{ section.settings.stat_2_label }}</span>
          </div>

          <div class="about-craft__highlight-item">
            <svg class="about-craft__highlight-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
            <span class="about-craft__highlight-value">{{ section.settings.stat_3_val }}</span>
            <span class="about-craft__highlight-label">{{ section.settings.stat_3_label }}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Craftsmanship",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F7F3EB"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Workbench Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE PROCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Raw Grain to Radiant Form"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>The journey begins with grain—solid recycled 18k gold and platinum melted, rolled, and drawn into wire through pure physical devotion. In our quiet atelier, flame and steel give way to deliberate hand manipulation.</p><p>Hours of meticulous filing, microscopic prong setting, and multi-stage mirror buffing follow until the metal achieves a liquid warmth against the skin. No piece leaves the bench until it meets the rigorous gaze of our master jeweler.</p>"
    },
    {
      "type": "header",
      "content": "Highlight 1"
    },
    {
      "type": "text",
      "id": "stat_1_val",
      "label": "Stat 1 Value",
      "default": "100% Recycled Gold"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Consciously cast"
    },
    {
      "type": "header",
      "content": "Highlight 2"
    },
    {
      "type": "text",
      "id": "stat_2_val",
      "label": "Stat 2 Value",
      "default": "40+ Hours"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Devoted to each piece"
    },
    {
      "type": "header",
      "content": "Highlight 3"
    },
    {
      "type": "text",
      "id": "stat_3_val",
      "label": "Stat 3 Value",
      "default": "Conflict-Free"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Certified gemstones"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "About Craftsmanship",
      "settings": {
        "eyebrow": "THE PROCESS",
        "heading": "From Raw Grain to Radiant Form"
      }
    }
  ]
}
{% endschema %}

