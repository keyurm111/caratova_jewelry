{{ 'section-brand-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .brand-story__content-col,
  #shopify-section-{{ section.id }} .brand-story__container,
  #shopify-section-{{ section.id }} .brand-story__media-wrap,
  #shopify-section-{{ section.id }} .brand-story__placeholder {
    background-color: {{ section.settings.content_background | default: '#EFE8DC' }} !important;
  }
{%- endstyle -%}

<div class="brand-story-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="brand-story__container{% if section.settings.layout == 'image_first' %} brand-story__container--reversed{% endif %}">
      
      {%- if section.settings.layout == 'image_first' -%}
        <div class="brand-story__media-col">
          <div class="brand-story__media-wrap">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  widths: '400, 600, 800, 1000, 1400',
                  class: 'brand-story__img'
              }}
            {%- else -%}
              <div class="brand-story__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="brand-story__content-col">
        {%- if section.settings.eyebrow != blank -%}
          <span class="brand-story__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="brand-story__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="brand-story__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="brand-story__button-wrap">
            <a href="{{ section.settings.button_link | default: '#' }}" class="brand-story__btn">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.layout != 'image_first' -%}
        <div class="brand-story__media-col">
          <div class="brand-story__media-wrap">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  widths: '400, 600, 800, 1000, 1400',
                  class: 'brand-story__img'
              }}
            {%- else -%}
              <div class="brand-story__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story Craft",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR CRAFT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Patience, set in gold"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every Aurelle piece is cast, set, and finished by hand in a single atelier. We make fewer things, more carefully - and repair them for life.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "DISCOVER OUR CRAFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        {
          "value": "text_first",
          "label": "Text first (Image on right)"
        },
        {
          "value": "image_first",
          "label": "Image first (Text on right)"
        }
      ],
      "default": "text_first"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content Background Color",
      "default": "#EFE8DC"
    }
  ],
  "presets": [
    {
      "name": "Brand Story Craft"
    }
  ]
}
{% endschema %}

