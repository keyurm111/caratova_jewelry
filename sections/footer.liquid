{% comment %}
  Luxury Editorial Atelier Footer (Caratova)
  - Dynamic Menu Navigation: Main menu items are rendered as column headings,
    and their nested inner items are rendered as options under each heading.
  - Also supports admin blocks (Menu, Text, Image, Brand Information).
  - Underline Newsletter Form ("Quiet updates, occasionally.")
  - Full-width Monumental Wordmark (CARATOVA) without image.
  - Clean Copyright line: "© 2026 Caratova. All rights reserved."
  - Exact navbar side-padding matching across all viewports.
{% endcomment %}

{{ 'section-luxury-footer.css' | asset_url | stylesheet_tag }}

<footer class="luxury-footer color-{{ section.settings.color_scheme }} gradient" id="LuxuryFooter-{{ section.id }}">
  <div class="luxury-footer__inner page-width">
    
    {%- comment -%} 1. Top Section: Navigation Columns + Newsletter {%- endcomment -%}
    <div class="luxury-footer__top">
      
      {%- comment -%} Navigation Columns (Main option as heading, inner options as links) {%- endcomment -%}
      <div class="luxury-footer__nav-cols">
        
        {%- comment -%} Determine if menu has main items with nested inner items {%- endcomment -%}
        {%- assign footer_menu = section.settings.menu | default: linklists.footer -%}
        {%- assign has_nested_menu = false -%}
        {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
          {%- for main_link in footer_menu.links -%}
            {%- if main_link.links.size > 0 -%}
              {%- assign has_nested_menu = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if has_nested_menu -%}
          {%- comment -%} Case 1: Main menu items as column headings, nested sub-items as options {%- endcomment -%}
          {%- for main_item in footer_menu.links -%}
            <div class="luxury-footer__col">
              <h3 class="luxury-footer__col-title">
                {%- if main_item.url != blank and main_item.url != '#' -%}
                  <a href="{{ main_item.url }}" class="luxury-footer__col-title-link">{{ main_item.title | escape }}</a>
                {%- else -%}
                  {{ main_item.title | escape }}
                {%- endif -%}
              </h3>

              {%- if main_item.links.size > 0 -%}
                <ul class="luxury-footer__links">
                  {%- for inner_item in main_item.links -%}
                    <li>
                      <a href="{{ inner_item.url }}" class="luxury-footer__link{% if inner_item.active %} luxury-footer__link--active{% endif %}">
                        {{ inner_item.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}

        {%- elsif section.blocks.size > 0 -%}
          {%- comment -%} Case 2: Render admin-added blocks from Theme Customizer {%- endcomment -%}
          {%- for block in section.blocks -%}
            <div class="luxury-footer__col luxury-footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'link_list' -%}
                  {%- assign block_menu = block.settings.menu -%}

                  {%- comment -%} Check if this block menu has nested items {%- endcomment -%}
                  {%- assign block_has_nested = false -%}
                  {%- if block_menu != blank and block_menu.links.size > 0 -%}
                    {%- for l in block_menu.links -%}
                      {%- if l.links.size > 0 -%}
                        {%- assign block_has_nested = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                  {%- if block_has_nested -%}
                    {%- for main_item in block_menu.links -%}
                      <div class="luxury-footer__nested-subcol">
                        <h3 class="luxury-footer__col-title">
                          {%- if main_item.url != blank and main_item.url != '#' -%}
                            <a href="{{ main_item.url }}" class="luxury-footer__col-title-link">{{ main_item.title | escape }}</a>
                          {%- else -%}
                            {{ main_item.title | escape }}
                          {%- endif -%}
                        </h3>
                        {%- if main_item.links.size > 0 -%}
                          <ul class="luxury-footer__links">
                            {%- for inner_item in main_item.links -%}
                              <li>
                                <a href="{{ inner_item.url }}" class="luxury-footer__link{% if inner_item.active %} luxury-footer__link--active{% endif %}">
                                  {{ inner_item.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    {%- if block.settings.heading != blank -%}
                      <h3 class="luxury-footer__col-title">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}

                    {%- assign menu_links = block_menu.links -%}
                    {%- if menu_links == blank and block.settings.heading != blank -%}
                      {%- assign heading_handle = block.settings.heading | handle -%}
                      {%- assign menu_links = linklists[heading_handle].links -%}
                    {%- endif -%}

                    {%- if menu_links != blank and menu_links.size > 0 -%}
                      <ul class="luxury-footer__links">
                        {%- for link in menu_links -%}
                          <li>
                            <a href="{{ link.url }}" class="luxury-footer__link{% if link.active %} luxury-footer__link--active{% endif %}">
                              {{ link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h3 class="luxury-footer__col-title">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtext != blank -%}
                    <div class="luxury-footer__text-content rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- endif -%}

                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    <div class="luxury-footer__image-block" style="max-width: {{ block.settings.image_width }}px;">
                      {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'luxury-footer__block-img' }}
                    </div>
                  {%- endif -%}

                {%- when 'brand_information' -%}
                  {%- if settings.brand_headline != blank -%}
                    <h3 class="luxury-footer__col-title">{{ settings.brand_headline | escape }}</h3>
                  {%- endif -%}
                  {%- if settings.brand_description != blank -%}
                    <div class="luxury-footer__text-content rte">
                      {{ settings.brand_description }}
                    </div>
                  {%- endif -%}

              {%- endcase -%}
            </div>
          {%- endfor -%}

        {%- elsif footer_menu != blank and footer_menu.links.size > 0 -%}
          {%- comment -%} Case 3: Flat single menu fallback {%- endcomment -%}
          <div class="luxury-footer__col">
            <h3 class="luxury-footer__col-title">{{ footer_menu.title | default: 'Quick links' }}</h3>
            <ul class="luxury-footer__links">
              {%- for link in footer_menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="luxury-footer__link">
                    {{ link.title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Newsletter Column {%- endcomment -%}
      {%- if section.settings.newsletter_enable -%}
        <div class="luxury-footer__newsletter-col">
          {%- if section.settings.newsletter_eyebrow != blank -%}
            <h3 class="luxury-footer__col-title">{{ section.settings.newsletter_eyebrow }}</h3>
          {%- endif -%}
          {%- if section.settings.newsletter_heading != blank -%}
            <h4 class="luxury-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h4>
          {%- endif -%}
          
          {%- form 'customer', id: 'LuxuryFooterNewsletter', class: 'luxury-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="luxury-footer__input-wrap">
              <input
                type="email"
                name="contact[email]"
                id="LuxuryFooterEmail-{{ section.id }}"
                class="luxury-footer__input"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Email address' }}"
                required
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                aria-label="Email address"
              >
              <button type="submit" class="luxury-footer__submit-btn" aria-label="Subscribe to newsletter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>

            {%- if form.posted_successfully? -%}
              <p class="luxury-footer__form-message luxury-footer__form-message--success">
                {{ 'newsletter.success' | t | default: 'Thank you for subscribing.' }}
              </p>
            {%- elsif form.errors -%}
              <p class="luxury-footer__form-message luxury-footer__form-message--error">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endform -%}

          {%- comment -%} Social Media Icons {%- endcomment -%}
          {%- if section.settings.show_social -%}
            <div class="luxury-footer__social-links">
              <a href="{{ settings.social_instagram_link | default: '#' }}" class="luxury-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
              <a href="{{ settings.social_tiktok_link | default: settings.social_pinterest_link | default: '#' }}" class="luxury-footer__social-link" aria-label="Social media" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                </svg>
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} 2. Thin Hairline Middle Divider {%- endcomment -%}
    <div class="luxury-footer__divider"></div>

    {%- comment -%} 3. Monumental Brand Display: Letters (CARATOVA) - Full Width {%- endcomment -%}
    {%- if section.settings.show_wordmark -%}
      <div class="luxury-footer__brand-display">
        <div class="luxury-footer__brand-letters" aria-label="{{ section.settings.wordmark_text | default: 'CARATOVA' }}">
          {%- assign brand_chars = section.settings.wordmark_text | default: 'CARATOVA' | split: '' -%}
          {%- for char in brand_chars -%}
            <span class="luxury-footer__letter">{{ char }}</span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 4. Bottom Row: Copyright Only (Terms/Privacy/Returns removed) {%- endcomment -%}
    <div class="luxury-footer__bottom">
      <div class="luxury-footer__copyright">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Caratova. All rights reserved.' }}</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Luxury Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Menu",
      "info": "Displays main options as headings and their inner options as links under each heading."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show Newsletter Column",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Newsletter Eyebrow",
      "default": "NEWSLETTER"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Quiet updates, occasionally."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input Placeholder",
      "default": "Email address"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Monumental Brand Display"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show Brand Display",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Brand Display Wordmark",
      "default": "CARATOVA"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Caratova. All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Title",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Select Menu",
          "info": "Select any menu created in Online Store -> Navigation"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "OUR ATELIER"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Text",
          "default": "<p>Handcrafted fine jewelry designed to be worn every day and kept for life.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 400,
          "step": 10,
          "unit": "px",
          "label": "Image width",
          "default": 150
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "Brand Information",
      "settings": [
        {
          "type": "paragraph",
          "content": "Displays brand headline and description configured in Theme Settings."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Footer"
    }
  ]
}
{% endschema %}
