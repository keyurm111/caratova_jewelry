{{ 'section-luxury-cta-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_image = section.settings.image
  assign blend_color = section.settings.bottom_blend_color | default: '#F7F3EB'
  assign min_height = section.settings.section_min_height | default: 700
  assign gradient_height = section.settings.gradient_height | default: 280
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  html,
  body {
    background-color: {{ blend_color }};
  }

  #MainContent:has(#LuxuryCta-{{ section.id }}),
  .shopify-section:has(#LuxuryCta-{{ section.id }}) {
    background-color: {{ blend_color }};
    margin-bottom: -3px !important;
  }

  #LuxuryCta-{{ section.id }} {
    min-height: {{ min_height }}px;
    background-color: {{ blend_color }};
    margin-bottom: -3px !important;
    position: relative;
    z-index: 2;
  }

  #LuxuryCta-{{ section.id }} .luxury-cta__ambient-overlay {
    opacity: {{ overlay_opacity }};
  }

  #LuxuryCta-{{ section.id }} .luxury-cta__footer-connector {
    height: {{ gradient_height }}px;
    background: linear-gradient(
      to bottom,
      rgba(247, 243, 235, 0) 0%,
      rgba(247, 243, 235, 0.04) 15%,
      rgba(247, 243, 235, 0.16) 32%,
      rgba(247, 243, 235, 0.38) 50%,
      rgba(247, 243, 235, 0.68) 68%,
      rgba(247, 243, 235, 0.88) 82%,
      rgba(247, 243, 235, 0.97) 90%,
      {{ blend_color }} 94%,
      {{ blend_color }} 100%
    );
  }

  /* Seamless merge: eliminate any gap, line, or border into footer */
  .shopify-section:has(#LuxuryCta-{{ section.id }}) + .shopify-section,
  .shopify-section:has(#LuxuryCta-{{ section.id }}) + .shopify-section .luxury-footer,
  #MainContent:has(#LuxuryCta-{{ section.id }}) + .shopify-section-group-footer-group,
  #MainContent:has(#LuxuryCta-{{ section.id }}) + .shopify-section-group-footer-group .luxury-footer,
  body:has(#LuxuryCta-{{ section.id }}) .shopify-section-group-footer-group,
  body:has(#LuxuryCta-{{ section.id }}) .luxury-footer {
    border-top: none !important;
    outline: none !important;
    box-shadow: none !important;
    margin-top: -3px !important;
  }
{%- endstyle -%}

<section
  class="luxury-cta-section"
  id="LuxuryCta-{{ section.id }}"
  aria-label="{{ section.settings.heading | default: 'Find The Piece That Tells Your Story' | escape }}"
>
  {%- comment -%} Clean High-Resolution Luxury Editorial Jewelry Campaign Image {%- endcomment -%}
  {%- if bg_image != blank -%}
    {{
      bg_image
      | image_url: width: 2400
      | image_tag:
        loading: 'lazy',
        sizes: '100vw',
        widths: '600, 900, 1200, 1600, 2000, 2400',
        class: 'luxury-cta__bg-img'
    }}
  {%- else -%}
    <img
      src="{{ 'luxury-cta-atelier.jpg' | asset_url }}"
      alt="{{ section.settings.heading | escape }}"
      class="luxury-cta__bg-img"
      loading="lazy"
      width="1376"
      height="768"
    >
  {%- endif -%}

  {%- comment -%} Dark Ambiance Overlay for Text Contrast {%- endcomment -%}
  <div class="luxury-cta__ambient-overlay" aria-hidden="true"></div>

  {%- comment -%} Bottom Shade of Footer Background Color (#F7F3EB) - Merges seamlessly into the footer without any lines {%- endcomment -%}
  <div class="luxury-cta__footer-connector" aria-hidden="true"></div>

  {%- comment -%} Centered Content: Heading, Form/Button, and Subtext {%- endcomment -%}
  <div class="luxury-cta__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="luxury-cta__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.cta_type == 'newsletter' -%}
      <div class="luxury-cta__form-wrap">
        {% form 'customer', class: 'luxury-cta__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            id="LuxuryCtaForm--{{ section.id }}"
            type="email"
            name="contact[email]"
            class="luxury-cta__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="LuxuryCta-error--{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="LuxuryCta-success--{{ section.id }}"
            {% endif %}
            placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email address' }}"
            required
          >
          <button
            type="submit"
            class="luxury-cta__submit"
            name="commit"
            id="LuxuryCtaSubscribe--{{ section.id }}"
            aria-label="{{ section.settings.newsletter_button_label | default: 'Subscribe' | escape }}"
          >
            {{ section.settings.newsletter_button_label | default: 'Subscribe' | escape }}
          </button>
        {% endform %}
        {%- if form.posted_successfully? -%}
          <p class="luxury-cta__message" id="LuxuryCta-success--{{ section.id }}" tabindex="-1">
            {{ 'newsletter.success' | t | default: 'Thank you for subscribing.' }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <div class="luxury-cta__subtext">
        {{ section.settings.subtext }}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_type != 'newsletter' and section.settings.button_label != blank -%}
      <div class="luxury-cta__btn-wrap">
        <a
          href="{{ section.settings.button_link | default: routes.root_url | append: 'pages/contact' }}"
          class="luxury-cta__btn"
        >
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Luxury CTA Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find The Piece That Tells Your Story"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every AURELLE creation is designed to capture meaningful moments and become a timeless part of your journey. Handcrafted jewelry that lasts."
    },
    {
      "type": "select",
      "id": "cta_type",
      "label": "Action Style",
      "options": [
        {
          "value": "newsletter",
          "label": "Newsletter Email Form"
        },
        {
          "value": "button",
          "label": "Action Button"
        }
      ],
      "default": "newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Subscribe Button Label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Action Button (if Action Style is Button)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "CONTACT US"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Footer Blend & Overlay"
    },
    {
      "type": "color",
      "id": "bottom_blend_color",
      "label": "Footer blend color",
      "default": "#F7F3EB"
    },
    {
      "type": "range",
      "id": "gradient_height",
      "min": 150,
      "max": 450,
      "step": 10,
      "unit": "px",
      "label": "Bottom shade height",
      "default": 280
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Ambient overlay opacity",
      "default": 25
    },
    {
      "type": "range",
      "id": "section_min_height",
      "min": 400,
      "max": 950,
      "step": 25,
      "unit": "px",
      "label": "Minimum section height",
      "default": 700
    }
  ],
  "presets": [
    {
      "name": "Luxury CTA Banner",
      "settings": {
        "heading": "Find The Piece That Tells Your Story",
        "subtext": "Every AURELLE creation is designed to capture meaningful moments and become a timeless part of your journey. Handcrafted jewelry that lasts.",
        "button_label": "CONTACT US",
        "bottom_blend_color": "#F7F3EB",
        "gradient_height": 280,
        "section_min_height": 700
      }
    }
  ]
}
{% endschema %}
